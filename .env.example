# Copy this file to ".env" (cp .env.example .env). Never commit the real .env file.

# --- Core -------------------------------------------------------------------
# Secret used to sign sessions. OPTIONAL for local use: if left blank, a random key is generated once and
# stored in instance/.secret_key (git-ignored). For any shared/production use, set your own, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Debug mode: 0 = off (default, safe). Set to 1 only on your own machine while developing.
FLASK_DEBUG=0

# Port for "python run.py". 5001 avoids the macOS AirPlay Receiver, which occupies port 5000.
PORT=5001

# Set to true only when serving over HTTPS.
SESSION_COOKIE_SECURE=false

# --- Database ---------------------------------------------------------------
# Default (leave commented): SQLite file at instance/finance.db
# DATABASE_URL=sqlite:////absolute/path/to/finance.db

# --- Optional external AI (leave blank to use only the built-in advisor) -----
# Nothing is sent anywhere unless AI_API_KEY is set AND the user ticks the consent box in Profile & settings.
# Only aggregated totals are sent (no name, email or individual transactions).
# AI_PROVIDER:"anthropic", "openai", or "gemini"
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional. Set a model supported by your provider; leave blank to use the app's default. 
AI_MODEL=
# Optional custom endpoint URL
AI_BASE_URL=
